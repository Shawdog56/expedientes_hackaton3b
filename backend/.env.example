APP_NAME=Expedientes API
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
# LLM_API_KEY=

# Almacenamiento y limites de subida
STORAGE_DIR=/data/expedientes
MAX_PDF_MB=50
MAX_ZIP_MB=300
MAX_ZIP_DESCOMPRIMIDO_MB=1024
MAX_ARCHIVOS_ZIP=1000
MAX_RATIO_COMPRESION=100

# Base de datos
DATABASE_URL=postgresql+psycopg://expedientes:expedientes@db:5432/expedientes
