APP_NAME=Expedientes API
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
# LLM_API_KEY=
# Ollama: dos instancias de compose; las peticiones se reparten entre ellas y cada una atiende
# una a la vez. Para usar un Ollama en tu PC: OLLAMA_BASE_URLS=["http://host.docker.internal:11434"]
OLLAMA_BASE_URLS=["http://ollama-1:11434","http://ollama-2:11434"]
OLLAMA_BASE_URL=http://ollama-1:11434
OLLAMA_MODEL=qwen2.5:3b

# Almacenamiento y limites de subida
STORAGE_DIR=/data/expedientes
MAX_PDF_MB=50
MAX_IMAGEN_MB=25
MAX_IMAGEN_PIXELES=80000000
MAX_ZIP_MB=300
MAX_ZIP_DESCOMPRIMIDO_MB=1024
MAX_ARCHIVOS_ZIP=1000
MAX_RATIO_COMPRESION=100

# Base de datos
DATABASE_URL=postgresql+psycopg://expedientes:expedientes@db:5432/expedientes

# Seguridad de datos: genera los valores con
#   docker compose run --rm --no-deps backend python scripts/generar_claves.py servidor
# CLAVES_CIFRADO='{"v1": "<32 bytes en base64>"}'
# CLAVE_CIFRADO_ACTIVA=v1
# CLAVE_INDICE=<32 bytes en base64>
# PEPPER_PASSWORD=<32 bytes en base64>

# Autenticación entre entidades (JWT RS256, JWE opcional). Apagada por defecto.
# AUTH_REQUERIDA=true
# AUTH_AUDIENCIA=expedientes-api
# AUTH_CLAVES_EMISORES_DIR=/app/secretos/entidades
# AUTH_CLAVE_CIFRADO_PRIVADA=/app/secretos/api_cifrado_privada.pem
# AUTH_EXIGIR_CIFRADO=false
# AUTH_TTL_MAXIMO_SEG=900
