<file path="frontend/src/shared/utils/formatBytes.ts">
export function formatBytes(bytes: number): string {
  if (bytes <= 0) return '0 KB';

  const unidades = ['B', 'KB', 'MB', 'GB'];
  let valor = bytes;
  let indice = 0;

  while (valor >= 1024 && indice < unidades.length - 1) {
    valor /= 1024;
    indice += 1;
  }

  const decimales = indice === 0 ? 0 : 1;
  return `${valor.toFixed(decimales)} ${unidades[indice]}`;
}
</file>

<file path="frontend/src/shared/utils/readDroppedEntries.ts">
import type { ArchivoExpediente } from '../types/expediente';

export function obtenerEntryDesdeItem(item: DataTransferItem): FileSystemEntry | null {
  if (typeof item.webkitGetAsEntry === 'function') {
    return item.webkitGetAsEntry();
  }
  return null;
}

function leerDirectorioCompleto(reader: FileSystemDirectoryReader): Promise<FileSystemEntry[]> {
  return new Promise((resolve, reject) => {
    const entradas: FileSystemEntry[] = [];

    const leerLote = () => {
      reader.readEntries((lote) => {
        if (lote.length === 0) {
          resolve(entradas);
          return;
        }
        entradas.push(...lote);
        leerLote();
      }, reject);
    };

    leerLote();
  });
}

function obtenerArchivo(entry: FileSystemFileEntry): Promise<File> {
  return new Promise((resolve, reject) => entry.file(resolve, reject));
}

/**
 * Recorre un FileSystemEntry (archivo o carpeta) solo para listar nombres,
 * rutas relativas y tamaños, y conserva la referencia al File para subirlo.
 * Nunca lee el contenido de los archivos en el navegador.
 */
export async function listarArchivosDeEntry(
  entry: FileSystemEntry,
  rutaBase = '',
): Promise<ArchivoExpediente[]> {
  const ruta = rutaBase ? `${rutaBase}/${entry.name}` : entry.name;

  if (entry.isFile) {
    const archivo = await obtenerArchivo(entry as FileSystemFileEntry);
    return [{ nombre: archivo.name, ruta, tamano: archivo.size, file: archivo }];
  }

  if (entry.isDirectory) {
    const directorio = entry as FileSystemDirectoryEntry;
    const hijos = await leerDirectorioCompleto(directorio.createReader());
    const listas = await Promise.all(hijos.map((hijo) => listarArchivosDeEntry(hijo, ruta)));
    return listas.flat();
  }

  return [];
}
</file>

<file path="frontend/src/shared/utils/tiposArchivo.ts">
const EXTENSIONES_DOCUMENTO = ['.pdf', '.jpg', '.jpeg', '.png'];
const EXTENSIONES_PERMITIDAS = [...EXTENSIONES_DOCUMENTO, '.zip'];
const ARCHIVOS_DE_SISTEMA = new Set(['.ds_store', 'thumbs.db', 'desktop.ini']);

/** Valor para el atributo `accept` de los selectores de archivos. */
export const ACEPTAR_ARCHIVOS = EXTENSIONES_PERMITIDAS.join(',');

/** Texto para avisos al usuario. */
export const FORMATOS_PERMITIDOS = 'PDF, JPG, PNG o ZIP';

/** Archivos basura del sistema operativo que se descartan sin avisar. */
export function esArchivoDeSistema(nombre: string): boolean {
  const minusculas = nombre.toLowerCase();
  return ARCHIVOS_DE_SISTEMA.has(minusculas) || minusculas.startsWith('._');
}

export function esZip(nombre: string): boolean {
  return nombre.toLowerCase().endsWith('.zip');
}

/** Documento individual aceptado (PDF o imagen JPG/PNG); excluye el .zip. */
export function esDocumento(nombre: string): boolean {
  const minusculas = nombre.toLowerCase();
  return EXTENSIONES_DOCUMENTO.some((ext) => minusculas.endsWith(ext));
}

/** Prevalidación por extensión; el backend valida el contenido real. */
export function esArchivoPermitido(nombre: string): boolean {
  const minusculas = nombre.toLowerCase();
  return EXTENSIONES_PERMITIDAS.some((ext) => minusculas.endsWith(ext));
}
</file>

