import { Eye, X } from 'lucide-react';
import { AnimatePresence, motion } from 'motion/react';
import { useEffect, useRef, useState } from 'react';
import { EVIDENCIA_POR_PUNTO, HALLAZGOS_CRUZADOS } from '../../../shared/mockResults';
import { useAnimaciones } from '../../../shared/motion';
import type { EstadoValidacion, TipoDocumentalId } from '../../../shared/validationRules';

export interface SeleccionHallazgo {
  tipoId: TipoDocumentalId;
  reglaId: string;
  reglaEtiqueta: string;
  estado: EstadoValidacion;
  documentoNombre: string;
  documentoArchivo: string;
}

interface Props {
  seleccion: SeleccionHallazgo | null;
  onCerrar: () => void;
}

function identidad(seleccion: SeleccionHallazgo | null): string | null {
  return seleccion ? `${seleccion.tipoId}:${seleccion.reglaId}` : null;
}

export function FindingDrawer({ seleccion, onCerrar }: Props) {
  const { reducido, spring, transicionNormal } = useAnimaciones();
  const cerrarRef = useRef<HTMLButtonElement>(null);
  const elementoPrevioRef = useRef<HTMLElement | null>(null);
  const [indiceEvidencia, setIndiceEvidencia] = useState(0);

  // El índice de evidencia se reinicia cuando cambia la selección; se ajusta
  // durante el render (no en un efecto), siguiendo el patrón de React para
  // "adjusting state when a prop changes".
  const [identidadPrevia, setIdentidadPrevia] = useState<string | null>(null);
  const identidadActual = identidad(seleccion);
  if (identidadActual !== identidadPrevia) {
    setIdentidadPrevia(identidadActual);
    setIndiceEvidencia(0);
  }

  useEffect(() => {
    if (seleccion) {
      elementoPrevioRef.current = document.activeElement as HTMLElement | null;
      cerrarRef.current?.focus();
    } else {
      elementoPrevioRef.current?.focus();
    }
  }, [seleccion]);

  useEffect(() => {
    if (!seleccion) return;
    const handleKeyDown = (evento: KeyboardEvent) => {
      if (evento.key === 'Escape') onCerrar();
    };
    document.addEventListener('keydown', handleKeyDown);
    return () => document.removeEventListener('keydown', handleKeyDown);
  }, [seleccion, onCerrar]);

  const hallazgo = seleccion
    ? HALLAZGOS_CRUZADOS.find((item) => item.tipoId === seleccion.tipoId && item.reglaId === seleccion.reglaId)
    : undefined;
  const evidenciaSimple = seleccion ? EVIDENCIA_POR_PUNTO[`${seleccion.tipoId}:${seleccion.reglaId}`] : undefined;
  const evidenciaMostrada = hallazgo?.evidencias[indiceEvidencia];

  return (
    <AnimatePresence>
      {seleccion && (
        <div className="fixed inset-0 z-50">
          <motion.div
            className="absolute inset-0 bg-ink/40"
            onClick={onCerrar}
            aria-hidden="true"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            transition={transicionNormal}
          />
          <motion.div
            data-tour="panel-hallazgo"
            role="dialog"
            aria-modal="true"
            aria-labelledby="panel-hallazgo-titulo"
            initial={reducido ? { opacity: 0 } : { opacity: 0, x: '100%' }}
            animate={{ opacity: 1, x: 0 }}
            exit={reducido ? { opacity: 0 } : { opacity: 0, x: '100%' }}
            transition={spring}
            className="absolute right-0 top-0 flex h-full w-full flex-col bg-surface shadow-xl sm:w-[420px]"
          >
            <div className="flex items-center justify-between gap-3 border-b border-border px-5 py-4">
              <h2 id="panel-hallazgo-titulo" className="text-base font-semibold text-ink">
                {hallazgo ? hallazgo.titulo : seleccion.reglaEtiqueta}
              </h2>
              <button
                ref={cerrarRef}
                type="button"
                data-tour="cerrar-hallazgo"
                onClick={onCerrar}
                aria-label="Cerrar panel"
                className="flex h-9 w-9 shrink-0 items-center justify-center rounded-md text-muted transition-colors hover:bg-bg hover:text-ink"
              >
                <X className="h-4 w-4" aria-hidden="true" />
              </button>
            </div>

            <div className="flex-1 overflow-y-auto px-5 py-4">
              {hallazgo ? (
                <div className="space-y-4">
                  <p className="text-sm text-ink">
                    {hallazgo.descripcion} {hallazgo.tolerancia}.
                  </p>

                  <div className="overflow-x-auto rounded-lg border border-border">
                    <table className="w-full text-sm">
                      <thead>
                        <tr className="bg-bg text-left text-xs font-semibold uppercase tracking-wide text-muted">
                          <th scope="col" className="px-3 py-2">
                            Documento
                          </th>
                          <th scope="col" className="px-3 py-2">
                            Valor encontrado
                          </th>
                          <th scope="col" className="px-3 py-2">
                            Evidencia
                          </th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-border">
                        {hallazgo.evidencias.map((evidencia, indice) => (
                          <tr key={evidencia.documento}>
                            <td className="px-3 py-2 text-ink">{evidencia.documento}</td>
                            <td
                              className={`px-3 py-2 ${evidencia.esDiscrepante ? 'font-semibold text-warn' : 'text-ink'}`}
                            >
                              {evidencia.valor}
                            </td>
                            <td className="px-3 py-2">
                              <button
                                type="button"
                                onClick={() => setIndiceEvidencia(indice)}
                                aria-pressed={indiceEvidencia === indice}
                                className={`inline-flex items-center gap-1 rounded-md border px-2 py-1 text-xs font-medium transition-colors ${
                                  indiceEvidencia === indice
                                    ? 'border-brand bg-brand-soft text-ink'
                                    : 'border-border text-muted hover:border-brand/50'
                                }`}
                              >
                                <Eye className="h-3.5 w-3.5" aria-hidden="true" />
                                pág. {evidencia.pagina}
                              </button>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>

                  {evidenciaMostrada && (
                    <div>
                      <p className="mb-1.5 text-xs font-medium text-muted">
                        {evidenciaMostrada.documento} · pág. {evidenciaMostrada.pagina}
                      </p>
                      <p className="rounded-lg border border-border bg-bg p-3 font-mono text-xs text-ink">
                        {evidenciaMostrada.fragmento}
                      </p>
                    </div>
                  )}
                </div>
              ) : (
                <div className="space-y-4">
                  <p className="text-sm text-ink">
                    <span className="font-medium">{seleccion.documentoNombre}</span> · {seleccion.reglaEtiqueta}
                  </p>
                  {evidenciaSimple ? (
                    <>
                      <p className="text-sm text-ink">
                        Valor encontrado: <span className="font-medium">{evidenciaSimple.valorEncontrado}</span>
                      </p>
                      <div>
                        <p className="mb-1.5 text-xs font-medium text-muted">
                          {seleccion.documentoArchivo} · pág. {evidenciaSimple.pagina}
                        </p>
                        <p className="rounded-lg border border-border bg-bg p-3 font-mono text-xs text-ink">
                          {evidenciaSimple.fragmento}
                        </p>
                      </div>
                    </>
                  ) : (
                    <p className="text-sm text-muted">Sin evidencia de ejemplo disponible para este punto.</p>
                  )}
                </div>
              )}
            </div>
          </motion.div>
        </div>
      )}
    </AnimatePresence>
  );
}
</file>

<file path="frontend/src/proposals/b-panel/PanelExpedienteList.tsx">
import { Inbox, Sparkles } from 'lucide-react';
import { AnimatePresence, motion } from 'motion/react';
import { useAnimaciones } from '../../shared/motion';
import type { DocumentoParaVer, Expediente, TipoDocumental } from '../../shared/types/expediente';
import { esExpedienteListo } from '../../shared/utils/expediente';
import { REGLAS_VALIDACION } from '../../shared/validationRules';
import { ExpedienteTableRow } from './ExpedienteTableRow';

interface Props {
  expedientes: Expediente[];
  onQuitar: (id: string) => void;
  onReclasificar: (id: string, documentoId: string, tipo: TipoDocumental | null) => void;
  onAnalizar: () => void;
  onVer?: (documento: DocumentoParaVer) => void;
}

export function PanelExpedienteList({ expedientes, onQuitar, onReclasificar, onAnalizar, onVer }: Props) {
  const { reducido } = useAnimaciones();
  const listos = expedientes.filter(esExpedienteListo).length;
  const validando = expedientes.some((expediente) => expediente.estado === 'validando');

  if (expedientes.length === 0) {
    return (
      <div className="rounded-xl border border-dashed border-border bg-surface p-6">
        <div className="flex items-center gap-3">
          <Inbox className="h-6 w-6 shrink-0 text-muted" aria-hidden="true" />
          <div>
            <p className="text-[18px] font-semibold text-ink">La bandeja está vacía</p>
            <p className="text-sm text-muted">Un expediente completo incluye estos 4 documentos:</p>
          </div>
        </div>

        <div className="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {REGLAS_VALIDACION.map((tipo, indice) => (
            <motion.div
              key={tipo.id}
              initial={reducido ? { opacity: 0 } : { opacity: 0, y: 8 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.25, delay: indice * 0.06 }}
              className="flex items-start gap-3 rounded-[12px] border border-border bg-surface p-4"
            >
              <tipo.Icono className="h-[30px] w-[30px] shrink-0 text-brand" aria-hidden="true" />
              <div>
                <p className="text-[15px] font-semibold text-ink">{tipo.nombre}</p>
                <p className="text-[13px] text-muted">{tipo.descripcionCorta}</p>
              </div>
            </motion.div>
          ))}
        </div>
      </div>
    );
  }

  return (
    <div data-tour="bandeja-expedientes" className="rounded-xl border border-border bg-surface shadow-sm">
      <div className="flex items-center justify-between gap-3 border-b border-border px-4 py-3">
        <h2 className="text-sm font-semibold text-ink">Expedientes cargados</h2>
        <span className="text-xs font-medium text-muted">
          {expedientes.length} expediente{expedientes.length === 1 ? '' : 's'}
        </span>
      </div>

      <div className="overflow-x-auto">
        <table className="w-full min-w-[760px] text-sm">
          <thead>
            <tr className="bg-bg text-left text-xs font-semibold uppercase tracking-wide text-muted">
              <th scope="col" className="px-4 py-2.5 font-semibold">
                Expediente
              </th>
              <th scope="col" className="px-4 py-2.5 font-semibold">
                Origen
              </th>
              <th scope="col" className="px-4 py-2.5 font-semibold">
                Archivos
              </th>
              <th scope="col" className="px-4 py-2.5 font-semibold">
                Tamaño
              </th>
              <th scope="col" className="px-4 py-2.5 font-semibold">
                Estado
              </th>
              <th scope="col" className="px-4 py-2.5 text-right font-semibold">
                Acciones
              </th>
            </tr>
          </thead>
          <tbody className="divide-y divide-border">
            <AnimatePresence initial={false}>
              {expedientes.map((expediente, indice) => (
                <ExpedienteTableRow
                  key={expediente.id}
                  expediente={expediente}
                  indice={indice}
                  onQuitar={onQuitar}
                  onReclasificar={onReclasificar}
                  onVer={onVer}
                />
              ))}
            </AnimatePresence>
          </tbody>
        </table>
      </div>

      <div className="flex justify-end border-t border-border p-4">
        <motion.button
          type="button"
          data-tour="boton-analizar"
          onClick={onAnalizar}
          disabled={listos === 0 || validando}
          initial={reducido ? { opacity: 0 } : { opacity: 0, scale: 0.96 }}
          animate={{ opacity: 1, scale: 1 }}
          whileHover={reducido || listos === 0 || validando ? undefined : { scale: 1.02 }}
          whileTap={reducido || listos === 0 || validando ? undefined : { scale: 0.97 }}
          transition={{ type: 'spring', stiffness: 500, damping: 30 }}
          className="inline-flex items-center justify-center gap-2 rounded-md bg-brand px-4 py-2.5 font-medium text-white transition-colors hover:bg-brand-dark disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-brand"
        >
          <Sparkles className="h-4 w-4" aria-hidden="true" />
          {validando ? 'Validando expedientes…' : `Analizar ${listos} expediente${listos === 1 ? '' : 's'}`}
        </motion.button>
      </div>
    </div>
  );
}
</file>

