@import './styles/theme.css';

:root {
  color-scheme: light;
}

html,
body {
  overscroll-behavior-y: none;
}

/* Respaldo: si el navegador igual deja ver algo durante el rebote
   (p. ej. con touchpad), que sea del mismo color que el header/footer,
   no una franja gris. El fondo claro del contenido lo pone `body`. */
html {
  background-color: var(--color-ink);
}

body {
  margin: 0;
  background: var(--color-bg);
  color: var(--color-ink);
  font-family: var(--font-sans);
}

*:focus-visible {
  outline: 2px solid var(--color-brand);
  outline-offset: 2px;
  border-radius: 4px;
}

@keyframes fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* Brillo que sigue al cursor en la zona de carga. La posición llega por
   variables CSS (actualizadas en onPointerMove, sin estado de React) para
   que el seguimiento sea fluido; la visibilidad la controla :hover. */
.zona-carga {
  --x: 50%;
  --y: 50%;
}

.zona-carga::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: radial-gradient(180px circle at var(--x) var(--y), color-mix(in srgb, var(--color-brand) 10%, transparent), transparent 70%);
  opacity: 0;
  transition: opacity 0.2s ease;
  pointer-events: none;
}

.zona-carga:hover::before {
  opacity: 1;
}

@media (prefers-reduced-motion: reduce) {
  .zona-carga::before {
    display: none;
  }
}

/* Subrayado que se despliega de izquierda a derecha al pasar el ratón. */
.enlace-subrayado {
  position: relative;
  text-decoration: none;
}

.enlace-subrayado::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 100%;
  height: 1px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.2s ease;
}

.enlace-subrayado:hover::after,
.enlace-subrayado:focus-visible::after {
  transform: scaleX(1);
}

@media (prefers-reduced-motion: reduce) {
  .enlace-subrayado::after {
    transition: none;
  }
}
