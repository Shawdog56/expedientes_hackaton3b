<file path="frontend/src/proposals/b-panel/useDecisionFinal.ts">
import { useState } from 'react';
import { decidirExpediente } from '../../api/expedientes';
import type { DecisionFinal } from '../../shared/types/expediente';

export interface EstadoDecision {
  decision: DecisionFinal | null;
  /** Fecha en que el servidor registró la decisión. */
  decididoEn: string | null;
  guardando: boolean;
  error: string | null;
}

const SIN_DECISION: EstadoDecision = { decision: null, decididoEn: null, guardando: false, error: null };

/** Decisión final de la persona que revisa, por expediente del lote; se guarda en el servidor. */
export function useDecisionFinal() {
  const [porExpediente, setPorExpediente] = useState<Record<string, EstadoDecision>>({});

  const actualizar = (expedienteId: string, cambios: Partial<EstadoDecision>) => {
    setPorExpediente((actuales) => ({
      ...actuales,
      [expedienteId]: { ...(actuales[expedienteId] ?? SIN_DECISION), ...cambios },
    }));
  };

  const decidir = async (expedienteId: string, idServidor: string | undefined, decision: DecisionFinal) => {
    if (!idServidor) {
      actualizar(expedienteId, { error: 'El expediente no se guardó en el servidor; no se puede registrar la decisión.' });
      return;
    }
    actualizar(expedienteId, { guardando: true, error: null });
    try {
      const resultado = await decidirExpediente(idServidor, decision);
      actualizar(expedienteId, {
        guardando: false,
        decision: resultado.decision_final,
        decididoEn: resultado.decidido_en,
      });
    } catch (error) {
      actualizar(expedienteId, {
        guardando: false,
        error: error instanceof Error ? error.message : 'No se pudo registrar la decisión',
      });
    }
  };

  return { porExpediente, decidir, sinDecision: SIN_DECISION };
}
</file>

<file path="frontend/src/proposals/c-asistente/AsistenteApp.tsx">
import { useState } from 'react';
import { useExpedientes } from '../../shared/hooks/useExpedientes';
import { AsistenteHeader } from './AsistenteHeader';
import { AsistentePaso1 } from './AsistentePaso1';
import { AsistentePaso2 } from './AsistentePaso2';
import { AsistentePaso3 } from './AsistentePaso3';
import { AsistenteStepper } from './AsistenteStepper';
import type { PasoAsistente } from './types';

export function AsistenteApp() {
  const { expedientes, analizando, aviso, agregarExpedientes, quitarExpediente, analizarExpedientes } =
    useExpedientes();
  const [paso, setPaso] = useState<PasoAsistente>(1);

  const analisisIniciado = analizando || aviso !== null;
  const pasoMaximoHabilitado: PasoAsistente = analisisIniciado ? 3 : expedientes.length > 0 ? 2 : 1;

  const continuarAPaso2 = () => setPaso(2);
  const volverAPaso1 = () => setPaso(1);
  const volverAPaso2 = () => setPaso(2);

  const manejarAnalizar = () => {
    setPaso(3);
    analizarExpedientes();
  };

  return (
    <div className="min-h-screen bg-bg pb-20">
      <AsistenteHeader />
      <AsistenteStepper pasoActual={paso} pasoMaximoHabilitado={pasoMaximoHabilitado} onIrAPaso={setPaso} />
      <main className="py-4">
        {paso === 1 && (
          <AsistentePaso1
            expedientesCount={expedientes.length}
            onExpedientesCargados={agregarExpedientes}
            onContinuar={continuarAPaso2}
          />
        )}
        {paso === 2 && (
          <AsistentePaso2
            expedientes={expedientes}
            onQuitar={quitarExpediente}
            onVolver={volverAPaso1}
            onAnalizar={manejarAnalizar}
          />
        )}
        {paso === 3 && <AsistentePaso3 cargando={analizando} aviso={aviso} onVolver={volverAPaso2} />}
      </main>
    </div>
  );
}
</file>

