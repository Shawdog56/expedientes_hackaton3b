"""Modelo de datos del flujo:

carga -> clasificación -> extracción (agentes especialistas) -> validación cruzada (orquestador) -> verificación
"""

import uuid
from datetime import UTC, datetime
from enum import StrEnum
from typing import Any

from sqlalchemy import BigInteger, DateTime, Enum, Float, ForeignKey, String, Text
from sqlalchemy.orm import Mapped, mapped_column, relationship

from app.db.session import Base
from app.db.tipos import JSONCifrado, TextoCifrado
from app.domain.documentos import AGENTE_POR_TIPO, EstadoClasificacion, FormatoArchivo, TipoDocumental
from app.domain.estados import (  # noqa: F401  (reexportados para compatibilidad)
    DecisionFinal,
    EstadoExpediente,
    EstadoExtraccion,
    ResultadoValidacion,
)

def ahora() -> datetime:
    return datetime.now(UTC)


def enum_col(enum: type[StrEnum], **kwargs: Any):
    """Enum guardado como VARCHAR + CHECK (evita migraciones de tipos ENUM nativos)."""
    return Enum(
        enum,
        native_enum=False,
        length=40,
        values_callable=lambda e: [m.value for m in e],
        validate_strings=True,
        **kwargs,
    )


class Expediente(Base):
    __tablename__ = "expedientes"

    id: Mapped[uuid.UUID] = mapped_column(primary_key=True, default=uuid.uuid4)
    nombre: Mapped[str] = mapped_column(TextoCifrado("expedientes.nombre"))
    origen: Mapped[str] = mapped_column(String(20))  # carpeta | zip
    estado: Mapped[EstadoExpediente] = mapped_column(
        enum_col(EstadoExpediente), default=EstadoExpediente.CARGADO
    )
    creado_en: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=ahora)
    actualizado_en: Mapped[datetime] = mapped_column(
        DateTime(timezone=True), default=ahora, onupdate=ahora
    )
    # Decisión de la persona que revisa; independiente de `estado` (que lo mueven los agentes).
    decision_final: Mapped[DecisionFinal | None] = mapped_column(enum_col(DecisionFinal))
    decidido_en: Mapped[datetime | None] = mapped_column(DateTime(timezone=True))
    decidido_por: Mapped[str | None] = mapped_column(String(255))  # entidad del token; null sin autenticación

    documentos: Mapped[list["Documento"]] = relationship(
        back_populates="expediente", cascade="all, delete-orphan"
    )
    rechazados: Mapped[list["ArchivoRechazado"]] = relationship(
        back_populates="expediente", cascade="all, delete-orphan"
    )
    validaciones: Mapped[list["ValidacionCruzada"]] = relationship(
        back_populates="expediente",
        cascade="all, delete-orphan",
        order_by="ValidacionCruzada.creada_en.desc()",
    )

    def _conteo_tipos(self) -> dict[TipoDocumental, int]:
        conteo = {tipo: 0 for tipo in TipoDocumental}
        for doc in self.documentos:
            if doc.tipo_documental:
                conteo[doc.tipo_documental] += 1
        return conteo

    @property
    def tipos_faltantes(self) -> list[TipoDocumental]:
        return [tipo for tipo, n in self._conteo_tipos().items() if n == 0]

    @property
    def tipos_duplicados(self) -> list[TipoDocumental]:
        return [tipo for tipo, n in self._conteo_tipos().items() if n > 1]

    @property
    def completo(self) -> bool:
        return not self.tipos_faltantes


class Documento(Base):
    """Documento (PDF o imagen) validado y guardado en disco; unidad de trabajo para un agente especialista."""

    __tablename__ = "documentos"

    id: Mapped[uuid.UUID] = mapped_column(primary_key=True, default=uuid.uuid4)
    expediente_id: Mapped[uuid.UUID] = mapped_column(
        ForeignKey("expedientes.id", ondelete="CASCADE"), index=True
    )
    nombre: Mapped[str] = mapped_column(TextoCifrado("documentos.nombre"))
    ruta: Mapped[str] = mapped_column(TextoCifrado("documentos.ruta"))  # ruta relativa dentro del expediente
    ruta_almacenamiento: Mapped[str] = mapped_column(String(1024))  # archivo cifrado en el volumen, con nombre aleatorio
    tamano: Mapped[int] = mapped_column(BigInteger)
    paginas: Mapped[int]  # las imágenes cuentan como 1
    formato: Mapped[FormatoArchivo] = mapped_column(
        enum_col(FormatoArchivo), default=FormatoArchivo.PDF, server_default=FormatoArchivo.PDF.value
    )
    sha256: Mapped[str] = mapped_column(String(64), index=True)

    tipo_documental: Mapped[TipoDocumental | None] = mapped_column(
        enum_col(TipoDocumental), index=True
    )
    estado_clasificacion: Mapped[EstadoClasificacion] = mapped_column(
        enum_col(EstadoClasificacion)
    )
    fuente_clasificacion: Mapped[str | None] = mapped_column(String(20))  # nombre | carpeta | manual
    estado_extraccion: Mapped[EstadoExtraccion] = mapped_column(
        enum_col(EstadoExtraccion), default=EstadoExtraccion.PENDIENTE
    )
    creado_en: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=ahora)

    expediente: Mapped[Expediente] = relationship(back_populates="documentos")
    extracciones: Mapped[list["Extraccion"]] = relationship(
        back_populates="documento", cascade="all, delete-orphan"
    )

    @property
    def agente(self) -> str | None:
        return AGENTE_POR_TIPO.get(self.tipo_documental) if self.tipo_documental else None


class ArchivoRechazado(Base):
    __tablename__ = "archivos_rechazados"

    id: Mapped[uuid.UUID] = mapped_column(primary_key=True, default=uuid.uuid4)
    expediente_id: Mapped[uuid.UUID] = mapped_column(
        ForeignKey("expedientes.id", ondelete="CASCADE"), index=True
    )
    ruta: Mapped[str] = mapped_column(TextoCifrado("archivos_rechazados.ruta"))
    motivo: Mapped[str] = mapped_column(String(500))
    creado_en: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=ahora)

    expediente: Mapped[Expediente] = relationship(back_populates="rechazados")


class Extraccion(Base):
    """Salida de un agente especialista sobre un documento (una fila por intento)."""

    __tablename__ = "extracciones"

    id: Mapped[uuid.UUID] = mapped_column(primary_key=True, default=uuid.uuid4)
    documento_id: Mapped[uuid.UUID] = mapped_column(
        ForeignKey("documentos.id", ondelete="CASCADE"), index=True
    )
    agente: Mapped[str] = mapped_column(String(100))
    modelo: Mapped[str | None] = mapped_column(String(100))
    estado: Mapped[EstadoExtraccion] = mapped_column(
        enum_col(EstadoExtraccion), default=EstadoExtraccion.EN_PROCESO
    )
    # Características extraídas, p. ej. {"folio": "...", "propietario": "...", "superficie_m2": 120}
    # Se guarda cifrado (AES-256-GCM): en la base es texto ilegible.
    caracteristicas: Mapped[dict[str, Any] | None] = mapped_column(
        JSONCifrado("extracciones.caracteristicas")
    )
    confianza: Mapped[float | None] = mapped_column(Float)
    error: Mapped[str | None] = mapped_column(Text)
    iniciada_en: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=ahora)
    terminada_en: Mapped[datetime | None] = mapped_column(DateTime(timezone=True))

    documento: Mapped[Documento] = relationship(back_populates="extracciones")


class ValidacionCruzada(Base):
    """Resultado del agente orquestador sobre todo el expediente."""

    __tablename__ = "validaciones_cruzadas"

    id: Mapped[uuid.UUID] = mapped_column(primary_key=True, default=uuid.uuid4)
    expediente_id: Mapped[uuid.UUID] = mapped_column(
        ForeignKey("expedientes.id", ondelete="CASCADE"), index=True
    )
    resultado: Mapped[ResultadoValidacion] = mapped_column(enum_col(ResultadoValidacion))
    resumen: Mapped[str | None] = mapped_column(TextoCifrado("validaciones_cruzadas.resumen"))
    modelo: Mapped[str | None] = mapped_column(String(100))
    creada_en: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=ahora)

    expediente: Mapped[Expediente] = relationship(back_populates="validaciones")
    hallazgos: Mapped[list["Hallazgo"]] = relationship(
        back_populates="validacion", cascade="all, delete-orphan"
    )


class Hallazgo(Base):
    """Una regla de la validación cruzada, p. ej. 'el propietario coincide en escritura y predial'."""

    __tablename__ = "hallazgos"

    id: Mapped[uuid.UUID] = mapped_column(primary_key=True, default=uuid.uuid4)
    validacion_id: Mapped[uuid.UUID] = mapped_column(
        ForeignKey("validaciones_cruzadas.id", ondelete="CASCADE"), index=True
    )
    regla: Mapped[str] = mapped_column(String(100))
    resultado: Mapped[ResultadoValidacion] = mapped_column(enum_col(ResultadoValidacion))
    mensaje: Mapped[str] = mapped_column(TextoCifrado("hallazgos.mensaje"))
    # Valores comparados y documentos involucrados: {"escrituras": "Juan P.", "predial": "Juan Pérez", "documentos": [...]}
    evidencia: Mapped[dict[str, Any] | None] = mapped_column(JSONCifrado("hallazgos.evidencia"))

    validacion: Mapped[ValidacionCruzada] = relationship(back_populates="hallazgos")
</file>

<file path="frontend/src/proposals/b-panel/ExpedienteTableRow.tsx">
import { AlertCircle, ChevronRight, FileArchive, Files, Folder, Trash2 } from 'lucide-react';
import { AnimatePresence, motion } from 'motion/react';
import { useState } from 'react';
import { ChipTipo, FilaDocumento, Resumen } from '../../shared/components/ClasificacionExpediente';
import { useAnimaciones } from '../../shared/motion';
import {
  comoArchivoVisible,
  ETIQUETA_TIPO,
  TIPOS_DOCUMENTALES,
  type DocumentoParaVer,
  type Expediente,
  type TipoDocumental,
} from '../../shared/types/expediente';
import { formatBytes } from '../../shared/utils/formatBytes';
import { plural } from '../../shared/utils/plural';
import { esDocumento } from '../../shared/utils/tiposArchivo';

interface Props {
  expediente: Expediente;
  indice: number;
  onQuitar: (id: string) => void;
  onReclasificar: (id: string, documentoId: string, tipo: TipoDocumental | null) => void;
  onVer?: (documento: DocumentoParaVer) => void;
}

const ETIQUETA_ORIGEN: Record<Expediente['origen'], string> = {
  carpeta: 'Carpeta',
  zip: 'Archivo .zip',
  archivos: 'Archivos sueltos',
};

const ICONO_ORIGEN: Record<Expediente['origen'], typeof Folder> = {
  carpeta: Folder,
  zip: FileArchive,
  archivos: Files,
};

function etiquetas(tipos: TipoDocumental[]): string {
  return tipos.map((tipo) => ETIQUETA_TIPO[tipo]).join(', ');
}

export function ExpedienteTableRow({ expediente, indice, onQuitar, onReclasificar, onVer }: Props) {
  const { reducido } = useAnimaciones();
  const sinClasificar = expediente.documentos.filter((doc) => doc.tipo_documental === null);
  const [verDetalle, setVerDetalle] = useState<boolean | null>(null);
  // Se abre sola si hay documentos que requieren clasificación manual.
  const abierto = verDetalle ?? sinClasificar.length > 0;
  const esZip = expediente.origen === 'zip';
  const validado = expediente.estado === 'validado';
  const Icono = ICONO_ORIGEN[expediente.origen];
  const documentosEnviados = expediente.archivos.filter((archivo) => esDocumento(archivo.nombre));

  return (
    <>
      <motion.tr
        initial={reducido ? { opacity: 0 } : { opacity: 0, y: 6 }}
        animate={{ opacity: 1, y: 0 }}
        exit={reducido ? { opacity: 0 } : { opacity: 0, height: 0 }}
        transition={{ duration: 0.2, delay: reducido ? 0 : indice * 0.04 }}
        style={{ overflow: 'hidden' }}
      >
        <td className="px-4 py-3">
          <div className="flex items-center gap-2.5">
            <Icono className="h-4 w-4 shrink-0 text-brand" aria-hidden="true" />
            <span className="truncate font-medium text-ink">{expediente.nombre}</span>
          </div>
        </td>
        <td className="whitespace-nowrap px-4 py-3 text-muted">{ETIQUETA_ORIGEN[expediente.origen]}</td>
        <td className="px-4 py-3 text-muted">
          {validado ? expediente.documentos.length : esZip ? '—' : expediente.archivos.length}
        </td>
        <td className="whitespace-nowrap px-4 py-3 text-muted">{formatBytes(expediente.tamanoTotal)}</td>
        <td className="px-4 py-3 text-sm" role="status">
          <Resumen expediente={expediente} />
        </td>
        <td className="px-4 py-3">
          <div className="flex justify-end gap-1">
            <button
              type="button"
              onClick={() => setVerDetalle(!abierto)}
              aria-expanded={abierto}
              aria-label={
                abierto ? `Colapsar detalle de ${expediente.nombre}` : `Expandir detalle de ${expediente.nombre}`
              }
              className="flex h-11 w-11 shrink-0 items-center justify-center rounded-md text-muted transition-colors hover:bg-bg hover:text-ink"
            >
              <motion.span className="flex" animate={{ rotate: abierto ? 90 : 0 }} transition={{ duration: 0.2 }}>
                <ChevronRight className="h-4 w-4" aria-hidden="true" />
              </motion.span>
            </button>
            <button
              type="button"
              onClick={() => onQuitar(expediente.id)}
              aria-label={`Quitar expediente ${expediente.nombre}`}
              className="flex h-11 w-11 shrink-0 items-center justify-center rounded-md text-muted transition-colors hover:bg-error/10 hover:text-error"
            >
              <Trash2 className="h-4 w-4" aria-hidden="true" />
            </button>
          </div>
        </td>
      </motion.tr>
      <AnimatePresence initial={false}>
        {abierto && (
          <motion.tr
            initial={reducido ? { opacity: 0 } : { opacity: 0, height: 0 }}
            animate={{ opacity: 1, height: 'auto' }}
            exit={reducido ? { opacity: 0 } : { opacity: 0, height: 0 }}
            transition={{ duration: 0.2 }}
            style={{ overflow: 'hidden' }}
          >
            <td colSpan={6} className="space-y-3 border-t border-border bg-bg px-4 py-3">
              {validado ? (
                <>
                  <ul className="flex flex-wrap gap-1.5">
                    {TIPOS_DOCUMENTALES.map(({ valor, etiqueta }) => (
                      <ChipTipo key={valor} expediente={expediente} tipo={valor} etiqueta={etiqueta} />
                    ))}
                  </ul>
                  {expediente.tiposFaltantes.length > 0 && (
                    <p className="flex items-start gap-2 text-xs text-error">
                      <AlertCircle className="mt-0.5 h-3.5 w-3.5 shrink-0" aria-hidden="true" />
                      Faltan documentos: {etiquetas(expediente.tiposFaltantes)}.
                    </p>
                  )}
                  {expediente.tiposDuplicados.length > 0 && (
                    <p className="flex items-start gap-2 text-xs text-ink">
                      <AlertCircle className="mt-0.5 h-3.5 w-3.5 shrink-0 text-warn" aria-hidden="true" />
                      Hay más de un documento de: {etiquetas(expediente.tiposDuplicados)}.
                    </p>
                  )}
                  {expediente.documentos.length > 0 && (
                    <ul className="max-h-72 divide-y divide-border overflow-y-auto rounded-lg border border-border bg-surface p-1">
                      {[...expediente.documentos]
                        .sort((a, b) => Number(a.tipo_documental !== null) - Number(b.tipo_documental !== null))
                        .map((doc) => (
                          <FilaDocumento
                            key={doc.id}
                            doc={doc}
                            onCambiarTipo={(tipo) => onReclasificar(expediente.id, doc.id, tipo)}
                            onVer={
                              onVer
                                ? () =>
                                    onVer({
                                      titulo: expediente.nombre,
                                      archivos: expediente.documentos.map(comoArchivoVisible),
                                      indiceInicial: expediente.documentos.findIndex((item) => item.id === doc.id),
                                    })
                                : undefined
                            }
                          />
                        ))}
                    </ul>
                  )}
                </>
              ) : (
                <div className="flex flex-wrap gap-1.5">
                  {documentosEnviados.length === 0 ? (
                    <span className="text-xs text-muted">
                      {esZip
                        ? 'El contenido del .zip se revisa al validarlo.'
                        : 'No se encontraron documentos en este expediente.'}
                    </span>
                  ) : (
                    documentosEnviados.map((archivo) => (
                      <span
                        key={archivo.ruta}
                        className="rounded-full border border-border bg-surface px-2.5 py-1 text-xs text-ink"
                      >
                        {archivo.nombre}
                      </span>
                    ))
                  )}
                </div>
              )}
              {expediente.rechazados.length > 0 && (
                <div>
                  <p className="mb-1 text-xs font-medium text-error">
                    {plural(expediente.rechazados.length, 'archivo rechazado', 'archivos rechazados')}
                  </p>
                  <ul className="max-h-40 space-y-1 overflow-y-auto rounded-lg border border-error/30 bg-error/5 p-2">
                    {expediente.rechazados.map((archivo, posicion) => (
                      <li key={`${archivo.ruta}-${posicion}`} className="flex items-start gap-2 px-2 py-1 text-sm">
                        <AlertCircle className="mt-0.5 h-3.5 w-3.5 shrink-0 text-error" aria-hidden="true" />
                        <span className="min-w-0">
                          <span className="block truncate text-ink" title={archivo.ruta}>
                            {archivo.ruta}
                          </span>
                          <span className="block text-error">{archivo.motivo}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </td>
          </motion.tr>
        )}
      </AnimatePresence>
    </>
  );
}
</file>

